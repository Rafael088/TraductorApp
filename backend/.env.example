# Copia este archivo como backend/.env y rellena los valores.
# backend/.env está en .gitignore: nunca se sube a Git.

PORT=5000
DB_URI=tu_uri_de_mongodb
JWT_SECRET=tu_secreto

# Voz -> texto: Groq (tier gratuito, sin tarjeta).
# Clave en https://console.groq.com/keys
# Límites gratis: 20 req/min, 2.000/día, 8 h de audio/día, 25 MB por archivo.
GROQ_API_KEY=tu_clave_de_groq
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Traducción EN -> ES: OpenRouter.
# Clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=tu_clave_de_openrouter
# OPENROUTER_TRANSLATION_MODEL=openai/gpt-4o-mini
